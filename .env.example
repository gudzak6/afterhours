# Garmin Connect Personal API key.
# Create one while logged in at:
# https://connect.garmin.com/app/settings/personalApiToken
# The key is shown only once. It is exchanged server-side for a 24-hour bearer token.
# Never put this value in frontend code or commit a filled-in .env file.
GARMIN_PERSONAL_API_KEY=

# Optional override. The official default is https://personal.connectapi.garmin.com
# GARMIN_PERSONAL_API_BASE_URL=https://personal.connectapi.garmin.com

# How far back a sync looks, in days. The official client pages activities with start/limit.
GARMIN_SYNC_LOOKBACK_DAYS=90

# Page size passed to search_activities. The documented examples use 20.
GARMIN_SYNC_PAGE_SIZE=20

# Safety cap so a manual sync cannot walk the entire account in one request.
GARMIN_SYNC_MAX_ACTIVITIES=200

# Automatic sync interval. Set to 0 to disable the scheduler.
GARMIN_SYNC_INTERVAL_MINUTES=360

# OpenAI is used only for coaching reports and chat. Metrics stay in the Python code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Optional. The daily coaching email is sent only when the coach enables it and these are set.
# PUBLIC_APP_URL=http://127.0.0.1:3010
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# SQLite for local development. The same SQLAlchemy models target PostgreSQL.
# Example: postgresql+psycopg://coach:coach@localhost:5432/trainingcoach
DATABASE_URL=sqlite:///./data/coach.db
